{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "stress": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "infra:vnc:check": {
      "cache": false,
      "outputs": []
    },
    "infra:vnc:smoke": {
      "cache": false,
      "outputs": []
    },
    "infra:vnc:parity": {
      "cache": false,
      "outputs": []
    },
    "registry:generate": {
      "outputs": ["packages/integrations/src/generated/registry.ts"]
    },
    "security:scan": {
      "cache": false,
      "outputs": []
    }
  }
}
